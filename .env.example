# 服务器端生图服务。三项都留空时，网站显示「尚未配置生图服务」，
# 不会向外部地址发请求。不要使用 NEXT_PUBLIC_ 前缀，密钥不能进浏览器。
# 也不要把真实密钥提交到仓库。

IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=

# 可选。毫秒，默认 60000，范围 3000–120000。
IMAGE_API_TIMEOUT_MS=60000

# 可选。只有供应商确实接受这些字段时才打开，逗号分隔：
# negative,seed,steps,reference
# OpenAI 官方 Images API 不支持 negative / seed / steps。
# gpt-image-1 与 dall-e-2 的参考图会走 /images/edits；dall-e-3 不接受参考图。
IMAGE_API_CAPABILITIES=

# 可选。覆盖画幅到尺寸的映射，例如：
# IMAGE_API_SIZE_MAP=1:1=1024x1024,4:3=1536x1024,3:4=1024x1536
# 未知模型默认只有 1024x1024。单边限制 256–2048。
IMAGE_API_SIZE_MAP=
